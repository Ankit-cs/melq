generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String
  googleId  String?  @unique
  githubId  String?  @unique
  createdAt DateTime @default(now())

  workflows WorkflowDefinition[]
  runs      WorkflowRun[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// Blueprint structure for workflows
model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String
  description String?
  definition  Json
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User?  @relation(fields: [userId], references: [id])
  runs WorkflowRun[]

  @@map("workflow_definitions")
}

// Live execution of a workflow definition
model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  userId      String?
  status      RunStatus @default(PENDING)
  input       Json
  output      Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [id])
  user     User?              @relation(fields: [userId], references: [id])
  tasks    Task[]

  @@map("workflow_runs")
}

// Single step in a workflow run
model Task {
  id          String     @id @default(cuid())
  runId       String
  name        String
  type        AgentType
  status      TaskStatus @default(PENDING)
  input       Json
  output      Json?
  error       String?
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  dependsOn   Json       @default("[]")
  critical    Boolean    @default(true)
  nodeId      String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  run WorkflowRun @relation(fields: [runId], references: [id])

  @@map("tasks")
}

// Worker registry
model Agent {
  id           String      @id @default(cuid())
  name         String
  type         AgentType
  status       AgentStatus @default(OFFLINE)
  lastSeenAt   DateTime?
  tasksHandled Int         @default(0)
  tasksFailed  Int         @default(0)
  createdAt    DateTime    @default(now())

  @@unique([name, type])
  @@map("agents")
}

// =========================================================================
// AI AGENT BENCHMARKING & CHAOS TESTING MODELS
// =========================================================================

model BenchmarkSuite {
  id          String   @id @default(cuid())
  name        String
  category    String   // "RESEARCH", "CODING", "CUSTOMER_SUPPORT", "TOOL_USE"
  description String
  tasks       BenchmarkTask[]
  runs        BenchmarkRun[]
  createdAt   DateTime @default(now())

  @@map("benchmark_suites")
}

model BenchmarkTask {
  id              String   @id @default(cuid())
  suiteId         String
  title           String
  description     String
  prompt          String
  expectedOutput  String
  evalCriteria    Json     // Rules for scoring (e.g. requiredKeywords, regex, schema)
  availableTools  Json     // Tools allowed for this task: ["web_search", "calculator", "api_fetch"]
  createdAt       DateTime @default(now())

  suite           BenchmarkSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  executions      BenchmarkExecution[]

  @@map("benchmark_tasks")
}

model BenchmarkAgentProfile {
  id          String   @id @default(cuid())
  name        String   // e.g. "LangChain ReAct Agent", "CrewAI Multi-Role", "Melq Resilient Agent"
  framework   String   // "LangChain", "CrewAI", "AutoGen", "Melq", "CustomHTTP"
  modelName   String   // "gemini-2.0-flash", "gemini-1.5-flash", etc.
  description String?
  endpointUrl String?  // Optional webhook URL if external agent
  type        String   @default("INTERNAL_REACT") // INTERNAL_REACT, INTERNAL_NAIVE, INTERNAL_PIPELINE, EXTERNAL_WEBHOOK
  createdAt   DateTime @default(now())

  executions  BenchmarkExecution[]

  @@map("benchmark_agent_profiles")
}

model BenchmarkRun {
  id            String             @id @default(cuid())
  suiteId       String
  name          String
  status        BenchmarkRunStatus @default(PENDING)
  iterations    Int                @default(3) // Repeatability test (e.g., 3x or 5x)
  chaosConfig   Json               // { enableFailingTools: true, failureRate: 0.3, enableRateLimits: true, enableMisleadingContext: true }
  summary       Json?              // Aggregated metrics across all tested agents
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  suite         BenchmarkSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  executions    BenchmarkExecution[]

  @@map("benchmark_runs")
}

model BenchmarkExecution {
  id               String               @id @default(cuid())
  runId            String
  taskId           String
  agentId          String
  iteration        Int                  @default(1)
  status           ExecutionStatus      @default(PENDING)
  success          Boolean              @default(false)
  score            Float                @default(0.0) // 0 - 100
  latencyMs        Int                  @default(0)
  promptTokens     Int                  @default(0)
  completionTokens Int                  @default(0)
  totalCostUsd     Float                @default(0.0)
  stepsCount       Int                  @default(0)
  toolCallsCount   Int                  @default(0)
  chaosInjected    Boolean              @default(false)
  chaosType        String?
  chaosHandled     Boolean              @default(false)
  finalAnswer      String?
  evalNotes        String?
  error            String?
  createdAt        DateTime             @default(now())

  run              BenchmarkRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  task             BenchmarkTask         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent            BenchmarkAgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  traces           ExecutionTraceStep[]

  @@map("benchmark_executions")
}

model ExecutionTraceStep {
  id           String        @id @default(cuid())
  executionId  String
  stepIndex    Int
  type         TraceStepType
  name         String
  input        Json?
  output       Json?
  durationMs   Int           @default(0)
  tokens       Int?          @default(0)
  isChaos      Boolean       @default(false)
  chaosDetails String?
  createdAt    DateTime      @default(now())

  execution    BenchmarkExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@map("execution_trace_steps")
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum AgentType {
  LLM_AGENT
  HTTP_AGENT
  TRANSFORM_AGENT
  EXTRACTION_AGENT
  NOTIFICATION_AGENT
  STORAGE_AGENT
}

enum BenchmarkRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  ERROR
}

enum TraceStepType {
  THOUGHT
  TOOL_CALL
  TOOL_RESULT
  CHAOS_INJECTED
  FINAL_ANSWER
}
